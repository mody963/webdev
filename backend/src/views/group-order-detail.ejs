<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Order Details </title>
</head>
<body>
    <h1>GroupOrder #<%= groupOrder.id %></h1>

    <p><strong>Bean ID:</strong> <%= groupOrder.beanId %></p>

    <p><strong>Starter ID:</strong> <%= groupOrder.starterId %></p>

    <p><strong>Minimum Grams:</strong> <%= groupOrder.minimumGrams %></p>

    <p><strong>Closing Date:</strong> <%= groupOrder.closingDate %></p>

    <p><strong>Status:</strong> <%= groupOrder.status %></p>



    <hr>
    <h2> Shares</h2>

    <% if (groupOrder.shares && groupOrder.shares.length > 0) { %> <% groupOrder.shares.forEach(share => { %> <p> <strong>Member:</strong> <%= share.member?.name %> <strong>Grams:</strong> <%= share.grams %> </p> <% }) %>
    <% } else { %> <p>No shares yet.</p> <% } %>

    <h3>Total grams: <%= (groupOrder.shares || []).reduce((total, share) => total + share.grams, 0) %>/<%= groupOrder.minimumGrams %></h3>
    
    <a href="/grouporder">Back to group orders</a>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Order Details </title>
</head>
<body>
    <h1>GroupOrder #<%= groupOrder.id %></h1>

    <p><strong>Bean ID:</strong> <%= groupOrder.beanId %></p>


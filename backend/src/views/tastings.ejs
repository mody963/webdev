<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Tastings</title>
</head>
<body>
    <h1>Coffee Club Tastings</h1>
    <a href="/add-tasting">Host a new Tasting</a>
    <hr>
    
    <% tastings.forEach(tasting => { %>
        <div style="border: 1px solid black; padding: 1rem; margin-bottom: 1rem;">
            <h3><%= tasting.title %></h3>
            <p><strong>Host:</strong> <%= tasting.host %></p>
            <p><strong>Date &amp; Time:</strong> <%= tasting.dateTime %></p>
            <p><strong>Capacity:</strong> <%= tasting.capacity %> seats</p>
            <p><strong>Lineup:</strong> <%= tasting.lineup %></p>

            <% if (tasting.scores && tasting.scores.length > 0) { %>
                <h4>Cupping Scores:</h4>
                <ul>
                    <% tasting.scores.forEach(score => { %>
                        <li>
                            <strong><%= score.beanName %>:</strong> <%= score.points %> / 10 
                            — "<%= score.remark %>" (by <%= score.memberName %>)
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    <% }) %>
    
    <% if (tastings.length === 0) { %>
        <p>No tastings scheduled yet.</p>
    <% } %>
</body>
</html>
